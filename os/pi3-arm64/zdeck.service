[Unit]
Description=Z-DECK zombie chase (Pi 3 64-bit kiosk, systemd alternative to login hook)
After=multi-user.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# install-autostart.sh --with-systemd rewrites User=, WorkingDirectory= and
# ExecStart= for your actual user/home. Opt-in only: do NOT enable this
# together with the ~/.bash_profile login hook or the game launches twice.
User=pi
WorkingDirectory=/home/pi/zdeck
ExecStart=/home/pi/zdeck/zdeck-main.sh --auto
Restart=always
RestartSec=5
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
