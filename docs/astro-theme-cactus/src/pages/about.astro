---
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/base";

const meta = {
	description: "About Zombie Deck — a handheld Raspberry Pi zombie chase game by Bit By Bit.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			<strong>Zombie Deck</strong> is a hardware-based zombie chase game on a handheld Raspberry
			Pi terminal, built by <strong>Bit By Bit</strong> (Abhijith R & Adithya Vijay, NSS College
			Of Engineering Palakkad) for TinkerHub Useless Projects 3.0.
		</p>
		<p>
			Your street is a live zombie-infested map — and <strong>you</strong> are the controller. The
			deck renders your neighbourhood (roads + POIs from OpenStreetMap) as ASCII on a 3.5" TFT,
			spawns zombies around you using live GPS, and they chase you. You outrun zombies by
			<em>actually outrunning them</em>.
		</p>
		<p>Under the hood:</p>
		<ul class="list-inside list-disc" role="list">
			<li>Raspberry Pi 3 + 3.5" TFT display + NEO-6M GPS + M5Stack CardKB</li>
			<li>Python (<code>curses</code>) game plus a Rust (<code>ratatui</code>) port</li>
			<li>Offline OpenStreetMap data via the Overpass API</li>
		</ul>
		<p>
			Follow the build <a class="cactus-link inline-block" href={withBase("/showcase/")}>timeline</a> or check
			out the <a
				class="cactus-link inline-block"
				href="https://github.com/Adithyaa04/useless_project_bitbybit"
				rel="noreferrer"
				target="_blank">source repo</a
			>.
		</p>
	</div>
</PageLayout>
