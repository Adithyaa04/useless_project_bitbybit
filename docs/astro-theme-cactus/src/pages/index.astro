---
import Hero3D from "@/components/showcase/Hero3D.astro";
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/base";
---

<PageLayout meta={{ title: "Home" }}>
	{/* Centered product headline */}
	<section class="hero-intro pb-8 text-center">
		<p class="text-xs font-semibold tracking-widest text-accent uppercase">
			Bit By Bit · Useless Projects 3.0
		</p>
		<h1 class="title mt-2 mb-3 text-4xl!">Zombie Deck</h1>
		<p class="mx-auto max-w-xl text-sm text-muted">
			A handheld Raspberry Pi zombie chase game — your street is the map,
			you are the controller.
		</p>
	</section>

	{/* Wide showcase card */}
	<Hero3D />

	{/* Project description */}
	<section class="mx-auto max-w-2xl pt-10 pb-4">
		<div class="prose prose-sm prose-cactus max-w-none">
			<p>
				A hardware-based zombie chase game on a handheld Raspberry Pi terminal. Your street is a
				live zombie-infested map — and <strong>you</strong> are the controller. No joystick, no
				WASD (unless you're indoors testing). You outrun zombies by
				<em>actually outrunning them</em>.
			</p>
			<p>
				Turn it on, it loads your locality onto the TFT, tracks your movement over live GPS, and
				drops zombies on the map — converting a casual evening jog into a low-budget survival
				experiment. Built with Python + Rust, OpenStreetMap offline maps, NEO-6M GPS, and a
				M5Stack CardKB.
			</p>
			<p>
				<a class="cactus-link inline-block text-accent" href={withBase("/showcase/")}
					>Follow the build timeline →</a
				>
			</p>
		</div>
	</section>
</PageLayout>

<style>
	.hero-intro {
		animation: rise 0.6s ease-out both;
	}
	@keyframes rise {
		from {
			opacity: 0;
			translate: 0 12px;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-intro {
			animation: none;
		}
	}
</style>
